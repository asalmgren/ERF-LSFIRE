# ====================================
# ELMFIRE Fire Test Case - Constant Wind
# ====================================
# This test case demonstrates ELMFIRE fire spread with constant wind
# (offline mode, no atmospheric coupling)

# ------ PROBLEM SETUP ------
erf.init_type = "uniform"

# ------ DOMAIN ------
# 3 km x 3 km horizontal domain with 30 m resolution
geometry.prob_extent = 3000.0  3000.0  1000.0
geometry.is_periodic = 1 1 0

# 100 x 100 horizontal cells, 30 m cell size
amr.n_cell = 100 100 32
amr.max_level = 0

# ------ BOUNDARY CONDITIONS ------
# For periodic directions (x,y): DO NOT specify BC types
# Only specify z-direction BCs
zlo.type = "NoSlipWall"
zhi.type = "SlipWall"

# ------ TIME STEPPING ------
# Run for 1 hour (3600 s) of fire spread
max_step = 100000
stop_time = 3600.0
erf.fixed_dt = 1.0
erf.cfl = 0.9

# ------ PHYSICS ------
erf.use_gravity = true
erf.use_coriolis = false
erf.moisture_model = "None"

# ------ TURBULENCE ------
erf.les_type = "None"
erf.molec_diff_type = "None"
erf.rho0_trans = 1.0

# ------ FIRE MODEL ------
# Select ELMFIRE fire spread model
erf.fire_type = "ELMFIRE"

# ELMFIRE configuration
fire.mode = "constant_wind"
fire.verbosity = 1

# Fuel model (102 = GR2 moderate grass)
fire.uniform_fuel_id = 102
fire.fuel_database_path = "fuel_models.csv"

# Constant wind parameters
fire.constant_wind_u = 4.89    # m/s (eastward wind)
fire.constant_wind_v = 0.0     # m/s (no north/south wind)
fire.wind_height = 10.0        # m (reference height)

# Fuel moisture content (fraction)
fire.fuel_moisture_1hr = 0.03         # 3% for 1-hour fuels
fire.fuel_moisture_10hr = 0.03        # 3% for 10-hour fuels
fire.fuel_moisture_100hr = 0.03       # 3% for 100-hour fuels
fire.fuel_moisture_live_herb = 0.30   # 30% for live herbaceous
fire.fuel_moisture_live_woody = 0.60  # 60% for live woody

# Terrain slope (uniform, flat terrain)
fire.uniform_slope_x = 0.0
fire.uniform_slope_y = 0.0

# Ignition parameters
fire.ignition_x = 1500.0       # m (center of domain)
fire.ignition_y = 1500.0       # m (center of domain)
fire.ignition_radius = 50.0    # m (50 m radius circle)
fire.ignition_time = 0.0       # s (ignite at start)

# Numerical parameters
fire.cfl = 0.9
fire.band_thickness = 5        # cells in narrow band

# ------ OUTPUT ------
erf.plot_file_1 = plt
erf.plot_int_1 = 30            # Output every 30 seconds

# Plot variables
erf.plot_vars_1 = density x_velocity y_velocity temp \
                  fire_phi fire_heat_flux fire_vel_u fire_vel_v fire_tagged

erf.check_file = chk
erf.check_int = -1             # No checkpoints

# ------ VERBOSITY ------
erf.v = 1
amrex.v = 0

# ------ INITIAL CONDITIONS ------
# Uniform atmosphere (quiescent, no initial wind from atmosphere)
prob.rho_0 = 1.2               # kg/m³
prob.T_0 = 300.0               # K
prob.U_0 = 0.0                 # m/s (atmosphere quiescent)
prob.V_0 = 0.0                 # m/s
prob.W_0 = 0.0                 # m/s
